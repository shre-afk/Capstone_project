@startuml 2_Dashboard_Sequence_Diagram_Overview_Load
title Overview page load (src/ui/dashboard/Overview.py)
skinparam monochrome true
skinparam shadowing false

actor User
participant "Overview.py" as Page
participant DashboardErrorHandler as EH
participant api
participant ":MetricCard" as Card

User -> Page : open Overview
activate Page

Page -> EH : execute(list_buildings)
activate EH
EH -> api : list_buildings()
activate api
api --> EH : buildings
deactivate api
EH --> Page : buildings
deactivate EH

loop for each building
  Page -> EH : execute(api.get_*)
  activate EH
  EH -> api : get_*(...)
  activate api
  api --> EH : result
  deactivate api
  EH --> Page : result
  deactivate EH
end

opt call fails
  EH --> Page : DashboardOperationError
  Page -> Page : st.warning()
end

Page -> Card : initialize()
activate Card
deactivate Card
Page --> User : render page
deactivate Page

note over Page, api
  get_* = get_latest, get_kpis, get_timeseries, get_savings.
  A fatal load failure (list_buildings) shows st.error and st.stop().
end note
@enduml
