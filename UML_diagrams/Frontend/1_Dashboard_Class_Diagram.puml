@startuml 1_Dashboard_Class_Diagram
title Dashboard UI layer (src/ui/dashboard)
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

package "ui.dashboard (Streamlit pages)" {
  class "Overview.py" as Overview <<page>>
  class "Buildings.py" as Buildings <<page>>
  class "EnergyAnalytics.py" as EnergyAnalytics <<page>>
  class "Forecasting.py" as Forecasting <<page>>
  class "Advisor.py" as Advisor <<page>>
  class "Reports.py" as Reports <<page>>
}

class DashboardHeader {
  - title : str
  - subtitle : str
  + initialize() : None
}

class MetricCard {
  - label : str
  - value : Any
  - key : str
  - icon : str | None
  - delta : str | None
  + initialize() : None
}

class PropertyCard {
  - building : dict
  + selected : bool
  + initialize() : bool
}

class DashboardErrorHandler {
  {static} + message(error, operation) : str
  {static} + execute(operation, callback, ...) : Any
}

class DashboardOperationError
class RuntimeError

class "backend.analysis.api" as api <<module>> {
  + list_buildings()
  + get_latest(building_id)
  + get_kpis(building_id, ...)
  + get_timeseries(building_id, ...)
  + get_savings(building_id, ...)
  + get_score(building_id, ...)
  + get_forecast(building_id, days)
}

DashboardOperationError --|> RuntimeError
DashboardErrorHandler ..> DashboardOperationError : <<raises>>

Overview ..> DashboardHeader : <<use>>
Overview ..> MetricCard : <<use>>
Overview ..> DashboardErrorHandler : <<use>>
Overview ..> api : <<use>>

Buildings ..> DashboardHeader : <<use>>
Buildings ..> MetricCard : <<use>>
Buildings ..> PropertyCard : <<use>>
Buildings ..> api : <<use>>

EnergyAnalytics ..> DashboardHeader : <<use>>
EnergyAnalytics ..> api : <<use>>

Forecasting ..> DashboardHeader : <<use>>
Forecasting ..> DashboardErrorHandler : <<use>>
Forecasting ..> api : <<use>>

Advisor ..> DashboardHeader : <<use>>

Reports ..> DashboardErrorHandler : <<use>>
Reports ..> api : <<use>>

note bottom of Advisor
  Advisor.py does not call api directly:
  advisor.agent -> advisor.tools -> api
end note
@enduml
